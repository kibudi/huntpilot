# Copy to .env at the repo root and fill in. .env is gitignored and must never be committed.

# Any MongoDB connection string. Atlas M0 is free and is what this was built against; a local
# mongod works too:  mongodb://127.0.0.1:27017
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.<id>.mongodb.net/?retryWrites=true&w=majority

# The database the app reads and writes. The test suite ignores this and uses huntpilot_test,
# which it drops after every run — so point MONGODB_URI at a cluster where that is safe.
MONGODB_DB=huntpilot
